# LearnFlow Backend Environment Configuration
# Copy to .env and adjust as needed

# Core
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database — SQLite for zero-config local dev, postgresql:// for production
DATABASE_URL=sqlite:///./learnflow.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/learnflow

# Security — CHANGE THIS IN PRODUCTION (use `openssl rand -hex 32`)
SECRET_KEY=learnflow-dev-secret-change-in-production-please-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# AI Agent — leave blank to use the built-in rule engine (always available)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
AGENT_BACKEND=auto

# Reward Economy
TOKEN_INITIAL_BALANCE=100
TOKEN_PER_FOCUS_MINUTE=2.0
TOKEN_PER_PRACTICE_CORRECT=5.0
TOKEN_PER_NOTE=3.0
